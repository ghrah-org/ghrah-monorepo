{
  "name": "@ghrah/observer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/assemble-plugins.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/assemble-plugins.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src/ && eslint src/ && prettier --check src/ && pnpm lint:i18n && pnpm lint:ui-tokens",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:ui-tokens": "node scripts/check-ui-tokens.mjs"
  },
  "dependencies": {
    "@ghrah/observer-core": "workspace:*",
    "@ghrah/plugin-registry": "workspace:*",
    "@ghrah/protocol": "workspace:*",
    "markdown-it": "^14.3.0",
    "monaco-editor": "^0.52.0",
    "parse-diff": "^0.12.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.10",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ghrah/mock-server": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@unocss/reset": "^66.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.0",
    "unocss": "^66.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
