{
  "name": "@ghrah/observer-core",
  "version": "0.2.0-alpha.0",
  "description": "Framework-agnostic observer client, projections, and Pinia stores for ghrah",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghrah/ghrah-monorepo.git",
    "directory": "ghrah-observer-webui/packages/observer-core"
  },
  "homepage": "https://github.com/ghrah/ghrah-monorepo#readme",
  "bugs": "https://github.com/ghrah/ghrah-monorepo/issues",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@ghrah/protocol": "workspace:*",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
